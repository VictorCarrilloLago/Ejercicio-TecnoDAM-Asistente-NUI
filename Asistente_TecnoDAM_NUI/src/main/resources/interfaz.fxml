<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tecnodam.InterfazController">

   <!-- ============ CABECERA ============ -->
   <top>
      <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12.0">
         <Label styleClass="app-title" text="TecnoDAM" />
         <Label styleClass="app-subtitle" text="Recepción de hardware" />
         <Region HBox.hgrow="ALWAYS" />
         <Label styleClass="app-subtitle" text="Maqueta · teclado y ratón" />
      </HBox>
   </top>

   <!-- ============ CENTRO: buscar + ficha (izquierda), stock (derecha) ============ -->
   <center>
      <HBox spacing="16.0">
         <padding>
            <Insets bottom="8.0" left="16.0" right="16.0" top="16.0" />
         </padding>

         <!-- Búsqueda, ficha y acciones -->
         <VBox styleClass="panel" minWidth="400.0" prefWidth="400.0" spacing="14.0">
            <Label styleClass="panel-title" text="Buscar componente" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <TextField fx:id="txtCodigo" promptText="Código (ej.: SSD-500)" HBox.hgrow="ALWAYS" />
               <Button fx:id="btnBuscar" defaultButton="true" onAction="#onBuscar" styleClass="btn-primary" text="Buscar" />
            </HBox>

            <VBox styleClass="card" spacing="8.0">
               <Label fx:id="lblNombre" styleClass="card-name" text="— Ningún componente —" wrapText="true" />
               <Label fx:id="lblCodigoInfo" styleClass="card-data" text="Código: —" />
               <Label fx:id="lblCategoria" styleClass="card-data" text="Categoría: —" />
               <Label fx:id="lblStock" styleClass="card-stock" text="Stock: —" />
            </VBox>

            <Label styleClass="field-label" text="Cantidad a añadir (1 a 10)" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Spinner fx:id="spCantidad" editable="true" initialValue="1" max="10" min="1" prefWidth="100.0" />
               <Button fx:id="btnAnadir" disable="true" maxWidth="Infinity" onAction="#onAnadir" styleClass="btn-primary" text="Añadir al stock" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Solo visible al pulsar "Añadir al stock" -->
            <VBox fx:id="boxConfirmacion" managed="false" spacing="10.0" styleClass="confirm-box" visible="false">
               <Label fx:id="lblConfirmacion" styleClass="confirm-text" text="¿Añadir 1 unidad?" wrapText="true" />
               <HBox spacing="10.0">
                  <Button fx:id="btnConfirmar" maxWidth="Infinity" onAction="#onConfirmar" styleClass="btn-ok" text="Confirmar" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCancelar" cancelButton="true" maxWidth="Infinity" onAction="#onCancelar" styleClass="btn-danger" text="Cancelar" HBox.hgrow="ALWAYS" />
               </HBox>
            </VBox>
         </VBox>

         <!-- Tabla de stock -->
         <VBox styleClass="panel" spacing="8.0" HBox.hgrow="ALWAYS">
            <Label styleClass="panel-title" text="Stock actual" />
            <TableView fx:id="tblStock" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                  <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre" />
                  <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                  <TableColumn fx:id="colStock" prefWidth="70.0" text="Stock" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </VBox>
      </HBox>
   </center>

   <!-- ============ ABAJO: mensajes + pie ============ -->
   <bottom>
      <VBox>
         <VBox styleClass="panel" spacing="8.0">
            <VBox.margin>
               <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
            </VBox.margin>
            <Label styleClass="panel-title" text="Mensajes" />
            <ListView fx:id="lvLog" prefHeight="110.0" />
         </VBox>
         <HBox alignment="CENTER_LEFT" styleClass="footer">
            <Label fx:id="lblPie" text="Listo." />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>